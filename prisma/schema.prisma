generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum FeedType {
  HOMENET
  CSV
  SFTP
}

enum BillingStatus {
  active
  expired
  past_due
}

enum PaymentStatus {
  succeeded
  failed
  processing
}

enum PaymentMethod {
  card
  us_bank_account
  invoice
}

model Dealer {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  feedUrl     String?
  contactName String?
  contactEmail String?
  contactPhone String?
  website     String?
  feedType    FeedType?
  homeNetDealerId String? @unique
  syncEnabled Boolean  @default(true)
  billingStatus BillingStatus @default(active)
  termStartAt DateTime?
  termEndAt   DateTime?
  stripeCustomerId String?
  lastReminderStage Int?
  cars        Car[]
  payments    Payment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([termEndAt])
}

model Car {
  id          String   @id @default(uuid())
  vin         String
  make        String
  model       String
  year        Int
  price       Decimal  @db.Decimal(10, 2)
  mileage     Int?
  imageUrl    String?
  features    Json?
  dealerId    String
  dealer      Dealer   @relation(fields: [dealerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([dealerId, vin])
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DealerContactRequest {
  id             String   @id @default(uuid())
  dealershipName String
  contactName    String
  email          String
  phone          String?
  interest       String?
  status         String   @default("new")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Payment {
  id                 String   @id @default(uuid())
  dealerId           String
  dealer             Dealer   @relation(fields: [dealerId], references: [id])
  amount             Int
  currency           String
  provider           String   @default("stripe")
  status             PaymentStatus
  method             PaymentMethod
  stripePaymentIntentId String?
  stripeInvoiceId    String?
  stripeSessionId    String?
  stripeCustomerId   String?
  termMonths         Int
  startDate          DateTime
  endDate            DateTime
  createdAt          DateTime @default(now())

  @@index([dealerId, createdAt])
  @@unique([stripePaymentIntentId])
  @@unique([stripeInvoiceId])
  @@unique([stripeSessionId])
}
