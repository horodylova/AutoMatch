generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum FeedType {
  HOMENET
  CSV
  SFTP
}

enum BillingStatus {
  active
  expired
  past_due
}

model Dealer {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  feedUrl     String?
  contactEmail String?
  feedType    FeedType?
  homeNetDealerId String? @unique
  syncEnabled Boolean  @default(true)
  billingStatus BillingStatus @default(active)
  termStartAt DateTime?
  termEndAt   DateTime?
  stripeCustomerId String?
  lastReminderStage Int?
  cars        Car[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([termEndAt])
}

model Car {
  id          String   @id @default(uuid())
  vin         String
  make        String
  model       String
  year        Int
  price       Decimal  @db.Decimal(10, 2)
  mileage     Int?
  imageUrl    String?
  features    Json?
  dealerId    String
  dealer      Dealer   @relation(fields: [dealerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([dealerId, vin])
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DealerContactRequest {
  id             String   @id @default(uuid())
  dealershipName String
  contactName    String
  email          String
  phone          String?
  interest       String?
  status         String   @default("new")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
